{
  "globalPassThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"],
  "globalDependencies": [
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "packages/tooling-config/oxfmt.config.ts",
    "packages/tooling-config/oxlint.config.ts",
    "references/tooling-config/oxfmt.config.ts",
    "references/tooling-config/oxlint.config.ts",
    "references/workspace-root/oxfmt.config.ts",
    "references/workspace-root/oxlint.config.ts"
  ],
  "tasks": {
    "//#boundaries": {
      "tags": ["quality:light"]
    },
    "//#check": {
      "tags": ["quality:entry"]
    },
    "//#check:containers": {
      "dependsOn": ["@boringparts/template#build"],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"]
    },
    "//#check:full": {
      "tags": ["quality:entry"]
    },
    "//#check:heavy": {
      "tags": ["quality:entry"]
    },
    "//#fix": {
      "tags": ["work:repair"]
    },
    "//#format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#format:write": {
      "cache": false,
      "dependsOn": ["//#lint:fix"],
      "tags": ["work:repair"]
    },
    "//#lint": {
      "dependsOn": ["^lint"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#typecheck": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#test": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#publication:pack": {
      "tags": ["work:release"],
      "cache": false
    },
    "//#publication:publish": {
      "tags": ["work:release"],
      "cache": false
    }
  },
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "allow": ["app", "library"]
        }
      },
      "library": {
        "dependencies": {
          "allow": ["library"]
        }
      },
      "cli": {
        "dependencies": {
          "allow": ["library", "app", "native"]
        }
      },
      "native": {
        "dependencies": {
          "allow": ["library"]
        }
      }
    }
  }
}
