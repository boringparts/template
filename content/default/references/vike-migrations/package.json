{
  "name": "@boringparts/reference-vike-migrations",
  "private": true,
  "files": [
    "drizzle.config.ts",
    "drizzle/migrations"
  ],
  "type": "module",
  "exports": {
    "./reference": "./package.json",
    "./template": {
      "source": "./template/definition.ts",
      "types": "./template-dist/definition.d.ts",
      "default": "./template-dist/definition.js"
    }
  },
  "scripts": {
    "check:author-planning-roles": "pnpm --workspace-root run author-planning-roles:workspace -- --owner-directory \"$PWD\"",
    "build": "tsc -p tsconfig.build.json --noEmit",
    "db:generate": "DATABASE_PROFILE=dev NODE_OPTIONS=--conditions=source drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:prepare:deploy": "pnpm run db:migrate",
    "db:push": "NODE_OPTIONS=--conditions=source drizzle-kit push",
    "db:studio": "DATABASE_PROFILE=dev NODE_OPTIONS=--conditions=source drizzle-kit studio",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "build:template": "rm -rf template-dist && tsc -p tsconfig.template.json --pretty false"
  },
  "dependencies": {
    "@boringparts/reference-vike-db": "workspace:*",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@boringparts/default-content-authoring": "workspace:*",
    "@boringparts/reference-tooling-config": "workspace:*",
    "@boringparts/reference-workspace-root": "workspace:*",
    "@boringparts/template-core": "workspace:*",
    "@boringparts/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript-7": "catalog:"
  }
}
