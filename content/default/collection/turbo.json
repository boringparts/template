{
  "extends": ["//"],
  "tags": ["template-content"],
  "tasks": {
    "build": {
      "dependsOn": [
        "@boringparts/template-core#build",
        "@boringparts/template-generator#build",
        "@boringparts/template-workspace#build",
        "@boringparts/preset-rust-bin#build",
        "@boringparts/preset-ts-cli#build",
        "@boringparts/preset-ts-lib#build",
        "@boringparts/preset-vike-app#build",
        "@boringparts/reference-rust-bin#build:template",
        "@boringparts/reference-ts-cli#build:template",
        "@boringparts/reference-ts-lib#build:template",
        "@boringparts/reference-tooling-config#build:template",
        "@boringparts/reference-vike-db#build:template",
        "@boringparts/reference-vike-migrations#build:template",
        "@boringparts/reference-vike-web#build:template",
        "@boringparts/template-workspace-authoring#build",
        "@boringparts/preset-vue-app#build",
        "@boringparts/reference-vue-app#build:template",
        "@boringparts/preset-vue-hono-app#build",
        "@boringparts/reference-hono-api#build:template",
        "@boringparts/reference-npm-publication#build:template",
        "@boringparts/reference-vue-hono-web#build:template"
      ],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"],
      "persistent": false
    },
    "format:check": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "lint": {
      "dependsOn": ["@boringparts/template-content-artifacts#build", "^lint"],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "lint:fix": {
      "dependsOn": ["@boringparts/template-content-artifacts#build"],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "test": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "test:integration": {
      "dependsOn": ["build", "@boringparts/template-content-artifacts#build"],
      "tags": ["quality:heavy"],
      "passThroughEnv": ["TEMPLATE_CONTENT_ARTIFACT_EVIDENCE_DIR"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "typecheck": {
      "dependsOn": [
        "@boringparts/template-content-artifacts#build",
        "^typecheck"
      ],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    }
  }
}
