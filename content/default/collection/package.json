{
  "name": "@boringparts/template-content",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern dist .",
    "lint:fix": "oxlint --format=unix --ignore-pattern dist . --fix",
    "test": "node --conditions=source --test --test-concurrency=2 --test-timeout=60000 'test/**/*.light.test.ts'",
    "test:integration": "node --test --test-concurrency=1 --test-timeout=300000 'test/**/*.integration.test.ts'",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false"
  },
  "dependencies": {
    "@boringparts/preset-node-lib": "workspace:*",
    "@boringparts/preset-rust-bin": "workspace:*",
    "@boringparts/preset-ts-cli": "workspace:*",
    "@boringparts/preset-ts-lib": "workspace:*",
    "@boringparts/preset-vike-app": "workspace:*",
    "@boringparts/preset-vue-app": "workspace:*",
    "@boringparts/preset-vue-hono-app": "workspace:*",
    "@boringparts/reference-hono-api": "workspace:*",
    "@boringparts/reference-node-lib": "workspace:*",
    "@boringparts/reference-npm-publication": "workspace:*",
    "@boringparts/reference-rust-bin": "workspace:*",
    "@boringparts/reference-tooling-config": "workspace:*",
    "@boringparts/reference-ts-cli": "workspace:*",
    "@boringparts/reference-ts-lib": "workspace:*",
    "@boringparts/reference-vike-db": "workspace:*",
    "@boringparts/reference-vike-migrations": "workspace:*",
    "@boringparts/reference-vike-web": "workspace:*",
    "@boringparts/reference-vue-app": "workspace:*",
    "@boringparts/reference-vue-hono-web": "workspace:*",
    "@boringparts/reference-workspace-root": "workspace:*",
    "@boringparts/template-core": "workspace:*",
    "@boringparts/template-generator": "workspace:*",
    "@boringparts/template-workspace": "workspace:*",
    "@boringparts/template-workspace-authoring": "workspace:*"
  },
  "devDependencies": {
    "@boringparts/default-content-authoring": "workspace:*",
    "@boringparts/template-content-artifacts": "workspace:*",
    "@boringparts/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "execa": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript-7": "catalog:"
  }
}
