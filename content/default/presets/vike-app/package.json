{
  "name": "@boringparts/preset-vike-app",
  "version": "0.0.0",
  "private": true,
  "files": [
    "template-dist",
    "resources",
    "scripts"
  ],
  "type": "module",
  "exports": {
    "./reference": "./package.json",
    "./template": {
      "source": "./template/definition.ts",
      "types": "./template-dist/definition.d.ts",
      "default": "./template-dist/definition.js"
    }
  },
  "scripts": {
    "check:author-planning-roles": "pnpm --workspace-root run author-planning-roles:workspace -- --owner-directory \"$PWD\"",
    "database:prepare:dev": "DATABASE_PROFILE=dev pnpm --filter @boringparts/reference-vike-migrations run db:push && DATABASE_PROFILE=dev pnpm --filter @boringparts/reference-vike-db run db:seed:example",
    "database:prepare:e2e": "DATABASE_PROFILE=e2e pnpm --filter @boringparts/reference-vike-db run db:reset && DATABASE_PROFILE=e2e pnpm --filter @boringparts/reference-vike-migrations run db:push && DATABASE_PROFILE=e2e pnpm --filter @boringparts/reference-vike-db run db:seed:example",
    "database:prepare:test": "DATABASE_PROFILE=test pnpm --filter @boringparts/reference-vike-db run db:reset && DATABASE_PROFILE=test pnpm --filter @boringparts/reference-vike-migrations run db:push && DATABASE_PROFILE=test pnpm --filter @boringparts/reference-vike-db run db:seed:example",
    "build": "pnpm run build:template",
    "build:template": "rm -rf template-dist && tsc -p tsconfig.template.json --pretty false",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern template-dist .",
    "lint:fix": "oxlint --format=unix --ignore-pattern template-dist . --fix",
    "test": "node --conditions=source --test --test-concurrency=2 --test-timeout=60000 'test/**/*.light.test.ts'",
    "test:integration": "node --conditions=source --test --test-concurrency=1 --test-timeout=300000 'test/**/*.integration.test.ts'",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false && tsc -p tsconfig.scripts.json --noEmit --pretty false"
  },
  "dependencies": {
    "@boringparts/reference-vike-db": "workspace:*",
    "@boringparts/reference-vike-migrations": "workspace:*",
    "@boringparts/reference-vike-web": "workspace:*",
    "@boringparts/reference-workspace-root": "workspace:*",
    "@boringparts/template-core": "workspace:*",
    "@boringparts/template-workspace": "workspace:*",
    "@boringparts/template-workspace-authoring": "workspace:*",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@boringparts/default-content-authoring": "workspace:*",
    "@boringparts/reference-npm-publication": "workspace:*",
    "@boringparts/reference-tooling-config": "workspace:*",
    "@boringparts/reference-ts-lib": "workspace:*",
    "@boringparts/template-generator": "workspace:*",
    "@boringparts/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "execa": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript-7": "catalog:"
  }
}
