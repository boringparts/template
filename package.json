{
  "name": "template",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "oxfmt --list-different --no-error-on-unmatched-pattern *.json pnpm-workspace.yaml pnpm-lock.yaml *.config.ts .gitignore rust-toolchain.toml .vscode .github .changeset/config.json .devcontainer scripts test",
    "format:write": "oxfmt --write --no-error-on-unmatched-pattern *.json pnpm-workspace.yaml pnpm-lock.yaml *.config.ts .gitignore rust-toolchain.toml .vscode .github .changeset/config.json .devcontainer scripts test",
    "lint": "oxlint --quiet --format=unix --no-error-on-unmatched-pattern *.config.ts scripts test",
    "lint:fix": "oxlint --format=unix --no-error-on-unmatched-pattern *.config.ts scripts test --fix",
    "typecheck": "tsc --build --noEmit --pretty false",
    "test": "node --conditions=source --test --test-reporter=spec 'test/**/*.test.ts'",
    "check": "node --conditions=source scripts/task-gates.ts check",
    "check:heavy": "node --conditions=source scripts/task-gates.ts check:heavy",
    "check:full": "node --conditions=source scripts/task-gates.ts check:full",
    "fix": "node --conditions=source scripts/task-gates.ts fix",
    "boundaries": "turbo boundaries",
    "publication:pack": "turbo run build && changeset pack --out-dir .changeset/packed",
    "publication:publish": "changeset publish --from-pack-dir .changeset/packed"
  },
  "devDependencies": {
    "@boringparts/tooling-config": "workspace:./packages/tooling-config",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "turbo": "catalog:",
    "typescript-7": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
