{
  "name": "@boringparts/template-presets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false"
  },
  "dependencies": {
    "@boringparts/reference-hono-api": "workspace:*",
    "@boringparts/reference-node-lib": "workspace:*",
    "@boringparts/reference-rust-bin": "workspace:*",
    "@boringparts/reference-tooling-config": "workspace:*",
    "@boringparts/reference-ts-cli": "workspace:*",
    "@boringparts/reference-ts-lib": "workspace:*",
    "@boringparts/reference-vike-db": "workspace:*",
    "@boringparts/reference-vike-deployment": "workspace:*",
    "@boringparts/reference-vike-migrations": "workspace:*",
    "@boringparts/reference-vike-web": "workspace:*",
    "@boringparts/reference-vue-app": "workspace:*",
    "@boringparts/reference-vue-hono-e2e": "workspace:*",
    "@boringparts/reference-vue-hono-web": "workspace:*",
    "@boringparts/reference-workspace-root": "workspace:*",
    "@boringparts/template-engine": "workspace:*"
  },
  "devDependencies": {
    "@boringparts/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript-7": "catalog:"
  }
}
