{
  "name": "@boringparts/template",
  "version": "0.4.0",
  "private": false,
  "description": "Composable meta-framework library for pnpm and Turborepo monorepos.",
  "keywords": [
    "monorepo",
    "pnpm",
    "project-template",
    "scaffolding",
    "turborepo"
  ],
  "homepage": "https://github.com/boringparts/template#readme",
  "bugs": {
    "url": "https://github.com/boringparts/template/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boringparts/template.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules --ignore-pattern dist .",
    "lint:fix": "oxlint --format=unix --ignore-pattern node_modules --ignore-pattern dist . --fix",
    "test": "node --conditions=source --test --test-reporter=spec 'test/unit/**/*.test.ts' 'test/integration/**/*.test.ts'",
    "test:dist": "node --test --test-timeout=180000 --test-reporter=spec 'test/distribution/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false"
  },
  "dependencies": {
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@boringparts/tooling-config": "workspace:*",
    "@types/node": "catalog:node-24",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript-7": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
