{
  "extends": ["//"],
  "tags": ["library"],
  "tasks": {
    "build": {
      "dependsOn": [
        "@boringparts/template-core#build",
        "@boringparts/template-workspace-authoring#build"
      ],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"],
      "persistent": false
    },
    "format:check": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "lint": {
      "dependsOn": ["build", "^lint"],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "lint:fix": {
      "dependsOn": ["build"],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "typecheck": {
      "dependsOn": ["build", "^typecheck"],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "test:integration": {
      "dependsOn": ["build", "@boringparts/template-generator#build"],
      "tags": ["quality:heavy"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    }
  }
}
