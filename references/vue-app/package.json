{
  "name": "@boringparts/reference-vue-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "default": "./src/main.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "vue-tsc --build --noEmit --pretty false",
    "browser:prepare": "playwright install chromium",
    "test:browser": "vitest run --project=browser --reporter=agent --silent=passed-only --fsModuleCachePath=node_modules/.vitest-cache/browser",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test": "vitest run --project=node --reporter=agent --silent=passed-only --fsModuleCachePath=node_modules/.vitest-cache/node"
  },
  "dependencies": {
    "@vue/devtools-api": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@boringparts/tooling-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/web-bluetooth": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vue/tsconfig": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
