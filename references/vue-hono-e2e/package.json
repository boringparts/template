{
  "name": "@boringparts/reference-vue-hono-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./reference": "./package.json"
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "browser:prepare": "playwright install chromium",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@boringparts/reference-hono-api": "workspace:*",
    "@boringparts/reference-tooling-config": "workspace:*",
    "@boringparts/reference-vue-hono-web": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "tsrs": "catalog:",
    "typescript-7": "catalog:"
  }
}
