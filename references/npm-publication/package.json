{
  "name": "@boringparts/reference-npm-publication",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --format=unix --no-error-on-unmatched-pattern . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "publication:pack": "turbo run build && changeset pack --out-dir .changeset/packed",
    "publication:publish": "changeset publish --from-pack-dir .changeset/packed"
  },
  "devDependencies": {
    "@boringparts/tooling-config": "workspace:*",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript-7": "catalog:"
  }
}
