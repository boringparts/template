{
  "name": "@boringparts/reference-vike-db",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#db/*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./queries/todos": {
      "source": "./src/queries/todos.ts",
      "types": "./dist/queries/todos.d.ts",
      "default": "./dist/queries/todos.js"
    },
    "./readiness": {
      "source": "./src/readiness.ts",
      "types": "./dist/readiness.d.ts",
      "default": "./dist/readiness.js"
    },
    "./schema": {
      "source": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./storage": {
      "source": "./src/storage.ts",
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "db:reset": "node --conditions=source --input-type=module -e \"import { resetDatabaseStorageTarget } from '#db/storage'; resetDatabaseStorageTarget();\"",
    "db:seed:example": "node --conditions=source scripts/seed-example.ts",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix --ignore-pattern node_modules . --fix",
    "test": "DATABASE_PROFILE=test node --conditions=source --test --test-reporter=spec 'test/**/*.test.ts'",
    "typecheck": "tsc --build --noEmit --pretty false"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@boringparts/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript-7": "catalog:"
  }
}
