{
  "name": "@boringparts/reference-ts-cli",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "reference-cli": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./reference": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "postbuild": "node -e \"if (process.platform !== 'win32') require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "node --conditions=source --test --test-reporter=spec 'test/unit/**/*.test.ts' 'test/integration/**/*.test.ts' 'test/e2e/source-journeys.test.ts'",
    "test:dist": "node --test --test-timeout=180000 --test-reporter=spec 'test/e2e/packed-journeys.test.ts'",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false"
  },
  "dependencies": {
    "@boringparts/cli-contract": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@boringparts/reference-tooling-config": "workspace:*",
    "@types/node": "catalog:node-24",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript-7": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
